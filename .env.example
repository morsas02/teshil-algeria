# نسخة من هذا الملف إلى .env وعبّئ القيم الحقيقية
# cp .env.example .env

# فارغ = SQLite محلي / اتصال PostgreSQL في الإنتاج
DATABASE_URL=
SECRET_KEY=change-me-in-production
BASE_URL=http://localhost:8080
PORT=8080

# حساب المشرف الافتراضي
ADMIN_EMAIL=admin@ta9eef.dz
ADMIN_PASSWORD=change-me-admin

# OAuth (اختياري)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=

# بريد احتياطي (SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

# إرسال البريد في الإنتاج (Brevo API)
BREVO_API_KEY=
BREVO_SENDER=
BREVO_SENDER_NAME=

# Web Push (VAPID)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@ta9eef.dz
